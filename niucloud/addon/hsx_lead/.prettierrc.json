{
    "printWidth": 120,
    "tabWidth": 4,
    "useTabs": false,
    "semi": false,
    "singleQuote": true,
    "trailingComma": "none",
    "endOfLine": "auto",
    "vueIndentScriptAndStyle": false,
    "htmlWhitespaceSensitivity": "strict",
    "overrides": [
        {
            "files": "*.php",
            "options": {
                "phpVersion": "8.0",
                "trailingCommaPHP": false,
                "braceStyle": "per-cs",
                "singleQuote": true
            }
        }
    ]
}
